# このファイルを .env にコピーして値を入れる（.env はリポジトリに入れない）
# キーが無くても動く（Claude を使わない「見本の整理」で流れが見える）
ANTHROPIC_API_KEY=
# Claude のモデル（空なら：まとめ・照合＝claude-opus-5-5／聞き返し・言い換え＝claude-haiku-5-5）
CLAUDE_MODEL_MAIN=
CLAUDE_MODEL_LIGHT=
# 1日に Claude を呼ぶ回数の上限（超えたら見本の規則で動く。空なら 200）
CLAUDE_MAX_CALLS_PER_DAY=
PORT=8793
# 公開するときの名前（例：tsugite.example.jp）。手元では空のまま
PUBLIC_HOST=
# デモの入口に全員の専用リンクを並べるか。空なら、手元で動かすときだけ出す。
# 公開して審査員に架空データで試してもらうときだけ 1（実際に町が配るときは空か 0）
DEMO_LINKS=
